# Copy to .env (gitignored). Clients, API keys and provider configs live in
# the database: manage them with
#   docker compose exec notify-service python -m app.admin --help

# The service's Postgres (notify-db).
NOTIFY_DB_PASSWORD=

# Encrypts stored provider configs and keys body MACs and receipt URLs.
# 32 random bytes, base64url. Back it up: without it, every stored config is
# unreadable and has to be set again.
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CONFIG_ENCRYPTION_KEY=

# How Jasmin reaches this service for delivery receipts. NOTIFY_BIND must
# then be an address Jasmin can reach (not 127.0.0.1 if Jasmin is elsewhere).
# Blank: no receipts are requested.
DLR_BASE_URL=
NOTIFY_BIND=127.0.0.1
NOTIFY_PORT=8010

# Log rows older than this are deleted; 0 keeps them forever.
MESSAGE_RETENTION_DAYS=365

# Allow SMTP without TLS (password sent in the clear). Leave off.
ALLOW_INSECURE_SMTP=false

PROVIDER_TIMEOUT_S=10
LOG_LEVEL=INFO
