# Copy to .env (gitignored). notify-service keeps no provider credentials:
# callers pass them with every request. These settings only say who may call
# it and where it may connect.

# Keys callers send as "Authorization: Bearer <key>", comma-separated (one
# per calling service, so one can be revoked alone). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Hosts a request may name as its Jasmin base_url, Inteliquent base_url
# override, or SMTP host. Exact names/IPs or *.wildcards; "*" allows any.
# Microsoft Graph and Inteliquent's default endpoint are always allowed.
EGRESS_ALLOWED_HOSTS=jasmin,smtp.office365.com

# Allow SMTP without TLS (password sent in the clear). Leave off.
ALLOW_INSECURE_SMTP=false

PROVIDER_TIMEOUT_S=10
LOG_LEVEL=INFO
